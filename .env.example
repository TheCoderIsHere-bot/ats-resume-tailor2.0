# Supabase Configuration
# NOTE: Never prefix server-only secrets with NEXT_PUBLIC_.
# Configure all production values securely in your hosting provider's encrypted env store (e.g. Vercel Environment Variables).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Canonical HTTPS origin used in production for OAuth/Magic-Link redirects
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Google Gemini AI (Server-only — do NOT prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key

# Razorpay Payment Gateway (Keep KEY_SECRET and WEBHOOK_SECRET strictly server-only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional: Out-of-band HTTPS webhook for critical security anomaly alerts (Slack/Discord/SIEM)
# SECURITY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
